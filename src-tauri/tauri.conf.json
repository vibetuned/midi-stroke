{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Midi Stroke",
  "version": "0.1.0",
  "identifier": "dev.midistroke.app",
  "build": {
    "beforeDevCommand": "npm run dev:tauri",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Midi Stroke",
        "width": 1440,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "appimage"],
    "category": "Music",
    "shortDescription": "Piano, drums & saxo MIDI trainer",
    "longDescription": "Midi Stroke is a music training app: it renders MEI scores with Verovio and listens to your MIDI instrument to score your playing in rhythm and practice modes.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "linux": {
      "deb": {
        "depends": ["libasound2t64 | libasound2"]
      }
    }
  }
}
